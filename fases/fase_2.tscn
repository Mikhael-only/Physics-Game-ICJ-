[node name="fase2" type="Node2D"]

[node name="ia_corrompidas" type="Node2D" parent="."]

[node name="IACorrompida" parent="ia_corrompidas" instance=ExtResource("1_qp5vu")]
position = Vector2(2007, 352)
falas = Array[String](["Você pode perceber que o pulo é um exemplo de trajetória oblíqua.", "Quando se pula, faz um arco no ar, você sobe e desce.", "O ângulo do pulo e a força que você coloca determinam onde vai parar.", "Mesmo que seja fraquinho que nem você.", "Que não consegue atravesar um buraco sem tropeçar."])

[node name="IACorrompida2" parent="ia_corrompidas" instance=ExtResource("1_qp5vu")]
position = Vector2(880, 608)
falas = Array[String](["Vemos que você sobreviveu ao portal.", "Não que pudesse ter algo de errado claro...", "Aqui vc terá que utlizar o que lhe ensinei no passado.", "Porém dessa vez terá que contar com a gravidade.", "A mecânica se chama trajetória oblíqua", "E ela que explica a rota curva de objetos lançados.", "Mais a frente falaremos mais."])

[node name="IACorrompida3" parent="ia_corrompidas" instance=ExtResource("1_qp5vu")]
position = Vector2(1867, -512)
falas = Array[String](["Vejo que você não é tão fraco para um nerd.", "Lembra que eu falei sobre a gravidade influênciar na trajetória oblíqua?", "Bom, outras coisas também podem.", "Vento, resistência, magnetismo, a janela da vizinha...", "Neste caso é algo mais exótico.", "Graças a quebra das leis físicas do mundo aparentemente apareceram orbes de gravidade.", "Grandes bolas que atraem tudo que chega perto.", "Você vai ter que usar elas se quiser atravesar o abismo.", "Só cuidado para não chegar muito perto do núcleo.", "A preção é tanta que você implode.", "Não queira saber o que é implosão..."])

[node name="IACorrompida4" parent="ia_corrompidas" instance=ExtResource("1_qp5vu")]
position = Vector2(2896, -624)
falas = Array[String](["Você não virou uma bolinha de carne haha.", "Estava ficando preocupado.", "Bom, agora a chance de morte é menor.", "Desta vez você pode escolher jogar a pedra.", "Você percebeu que estes orbes mudam a trajetória?", "Isso que eu lhe expliquei anteriormente.", "Agora você tem que fazer o mesmo com a pedra.", "Ela é bem resistente, entâo não implodirá."])

[node name="IACorrompida5" parent="ia_corrompidas" instance=ExtResource("1_qp5vu")]
position = Vector2(4678, -688)
falas = Array[String](["Não vou acompanhá-lo a partir daqui.", "A gravidade está muito forte, interferindo em minha frequência.", "Devo ficar aqui para não quebrar de vez.", "Outro fragmento está logo a frente.", "Guarde tudo que lhe falei, e coragem.", "O mundo é duro, mas belo.", "Vá e talvez nos veremos do outro lado."])

[node name="IACorrompida9" parent="ia_corrompidas" instance=ExtResource("1_qp5vu")]
position = Vector2(2232, -160)
falas = Array[String](["Aqui você vai usar seus bracinhos.", "Esta vendo aquela pedra? No chão logo a frente?", "Bom, você vai ter que lançar ela para o outro lado para ativar uma plataforma que ativa uma ponte.", "Aqui você deve aprender que o ângulo que você lança a pedra importa para ela ir longe ou perto. ", "Na maioria dos casos o ângulo que vai mais longe é o de 45º.", "Mas como não temos um transferidor no bolso o tempo todo, vamos no \"olhômetro\".", "Concentre-se em seguir a trajetória correta.", "Relaxa, é que nem jogar bolinha de papel na cesta de lixo.", "Você já acertou uma bolinha em uma cesta né ser humano?", "..."])

